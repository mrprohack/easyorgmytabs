{
  "manifest_version": 3,
  "name": "Tab Organizer Pro",
  "version": "1.1",
  "description": "Beautifully organize your tabs by date or website.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "favicon"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Tab Organizer Pro"
  },
  "commands": {
    "ARRANGE_BY_DATE": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Arrange tabs by date"
    },
    "ARRANGE_BY_WEBSITE": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "Arrange tabs by website"
    },
    "CLOSE_DUPLICATES": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Close duplicate tabs"
    }
  }
}
