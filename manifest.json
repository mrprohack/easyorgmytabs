{
  "manifest_version": 3,
  "name": "Tab Organizer Pro",
  "version": "1.0",
  "description": "Beautifully organize your tabs by date or website.",
  "permissions": [
    "tabs",
    "tabGroups"
  ],
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
